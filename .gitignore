# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Data and large artifacts (never commit datasets)
data/*
!data/.gitkeep
!data/download.py
outputs/*
!outputs/.gitkeep

# OS / editor
.DS_Store
.idea/

# Editor config IS committed so the .venv kernel is picked automatically.
# Ignore only the machine-specific bits.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
